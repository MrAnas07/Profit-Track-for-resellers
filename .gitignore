# env files (can opt-in for committing if needed)
.env*
!.env.example

# prisma generated client
/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pwa generated
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/swe-worker-*.js

# screenshots
/shots/
smoke-failure.png
smoke-debug.png

# ui review artifacts
/review/

# dev log
dev.log
